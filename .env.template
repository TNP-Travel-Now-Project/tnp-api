# === SA Password cho SQL Server (bắt buộc phải thay đổi) ===
SA_PASSWORD=<pass>

# === JWT Key (bắt buộc phải thay đổi, tối thiểu 32 ký tự) ===
JWT_KEY=<key>

# === JWT Issuer & Audience (tùy chọn) ===
JWT_ISSUER=<issuer>
